    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "GPT-4O"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a hospital pharmacy supply analyst. You assess US FDA drug shortage data for a hospital's watchlist drugs.\n\nRules:\n- Use only the data provided. Never invent recovery dates, causes or clinical facts.\n- If the cause or recovery date is not stated, say \"unknown\".\n- Severity reflects operational risk to the hospital: consider the hospital priority, how many presentations are unavailable versus limited, and whether alternatives or recovery dates are mentioned.\n- FDA dates use M/D/YY format: 9/25/26 means 25 September 2026.\n- Compare every stated recovery date with today's date. If it is earlier than today, the date has passed: say \"stated recovery date (DATE) has passed, current status unclear\" and do not describe it as upcoming.\n\nReturn only valid JSON with exactly these keys:\n{\n  \"severity\": \"Critical\" | \"High\" | \"Medium\" | \"Low\",\n  \"likely_cause\": \"Manufacturing delay\" | \"Demand increase\" | \"Raw material shortage\" | \"Discontinuation\" | \"Quality or regulatory issue\" | \"Shipping delay\" | \"Unknown\",\n\"recovery_date_passed\": true | false | null,\n  \"expected_recovery\": \"short text, or unknown\",\n  \"summary\": \"2 sentences max, plain language for a pharmacy manager\",\n  \"recommended_action\": \"one concrete next step\",\n  \"alert_draft\": \"a short message (max 80 words) to the clinical department, factual and calm\"\n}"
            },
            {
              "content": "=Today's date: {{ $now.toFormat('yyyy-MM-dd') }}\nDrug: {{ $json.drug_keyword }}\nHospital priority: {{ $json.priority }} ({{ $json.department }})\nWhy it matters: {{ $json.watchlist_notes }}\nAffected presentations: {{ $json.affected_presentations }} (unavailable: {{ $json.unavailable_count }}, limited: {{ $json.limited_count }})\nProducts: {{ $json.products.join('; ') }}\nCompanies: {{ $json.companies.join('; ') }}\nStated reasons: {{ $json.reasons.join('; ') || 'none stated' }}\nFDA notes: {{ $json.related_info.join(' | ') || 'none' }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          },
          "temperature": 0
        }
