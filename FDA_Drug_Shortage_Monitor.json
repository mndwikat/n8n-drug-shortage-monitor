    {
      "parameters": {
        "jsCode": "// 1. Watchlist rows from the Google Sheet\nconst watchlist = $('Get Watchlist').all().map(i => i.json);\n\n// 2. All cleaned FDA shortage records\nconst shortages = $input.all().map(i => i.json);\n\nconst groups = {};\n\nfor (const s of shortages) {\n  const name = (s.generic_name || '').toLowerCase();\n\n  // Find a watchlist drug whose keyword appears in the FDA generic name\n  const match = watchlist.find(w =>\n    name.includes(String(w.drug_keyword).toLowerCase())\n  );\n  if (!match) continue; // not on our watchlist, skip\n\n  // One group per watchlist drug\n  const key = match.drug_keyword;\n  if (!groups[key]) {\n    groups[key] = {\n      drug_keyword: key,\n      priority: match.priority,\n      department: match.department,\n      watchlist_notes: match.notes,\n      affected_presentations: 0,\n      unavailable_count: 0,\n      limited_count: 0,\n      products: new Set(),\n      companies: new Set(),\n      reasons: new Set(),\n      related_info: new Set(),\n    };\n  }\n\n  const g = groups[key];\n  g.affected_presentations += 1;\n  if (s.availability === 'Unavailable') g.unavailable_count += 1;\n  if (s.availability === 'Limited Availability') g.limited_count += 1;\n  g.products.add(s.generic_name);\n  if (s.company_name) g.companies.add(s.company_name);\n  if (s.shortage_reason) g.reasons.add(s.shortage_reason);\n  if (s.related_info) g.related_info.add(s.related_info);\n}\n\n// 3. Output one item per affected watchlist drug\nreturn Object.values(groups).map(g => ({\n  json: {\n    ...g,\n    products: [...g.products],\n    companies: [...g.companies],\n    reasons: [...g.reasons],\n    related_info: [...g.related_info].slice(0, 5),\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
