        "jsCode": "const items = $input.all().map(i => i.json);\nconst escalated = items.filter(d => d.escalate);\nconst monitored = items.filter(d => !d.escalate);\n\nconst line = d =>\n  `- ${d.drug} (${d.department}) | priority ${d.priority}, severity ${d.severity} | ${d.likely_cause} | recovery: ${d.expected_recovery}${d.recently_alerted ? ' | alert already sent this week' : ''}`;\n\nconst body = [\n  `Drug shortage digest for ${$now.toFormat('dd LLL yyyy')}`,\n  '',\n  `${items.length} watchlist drugs are currently in shortage. ${escalated.length} sent for approval.`,\n  '',\n  'ESCALATED (awaiting approval):',\n  ...(escalated.length ? escalated.map(line) : ['- none']),\n  '',\n  'MONITORING ONLY:',\n  ...(monitored.length ? monitored.map(line) : ['- none']),\n  '',\n  'Source: openFDA drug shortages (unvalidated data). Full history in the alert_log sheet.',\n].join('\\n');\n\nreturn [{\n  json: {\n    subject: `Drug shortage digest: ${escalated.length} need approval, ${items.length} in shortage`,\n    body,\n  },\n}];"
      },
