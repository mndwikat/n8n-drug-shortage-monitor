    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// The model's answer (handles both object and text formats)\nconst raw = $json.output?.[0]?.content?.[0]?.text;\nconst triage = typeof raw === 'string' ? JSON.parse(raw) : raw;\n\n// The matching drug record from before the LLM step\nconst drug = $('Match Watchlist').item.json;\n\n// Guardrail: only accept the severity values we defined\nconst validSeverity = ['Critical', 'High', 'Medium', 'Low'];\nif (!triage || !validSeverity.includes(triage.severity)) {\n  throw new Error(`Invalid LLM output for ${drug.drug_keyword}`);\n}\n\n// Change detection: was this drug's alert sent in the last 7 days?\nconst log = $('Get Alert Log').all().map(i => i.json);\nconst cutoff = $now.minus({ days: 7 }).toFormat('yyyy-MM-dd');\nconst recentlyAlerted = log.some(r =>\n  r.drug === drug.drug_keyword &&\n  r.decision === 'Sent' &&\n  String(r.run_date) >= cutoff\n);\n\n// Escalation rule, computed once\nconst meetsRule =\n  (drug.priority === 'Critical' && ['Critical', 'High'].includes(triage.severity)) ||\n  (drug.priority === 'High' && triage.severity === 'Critical');\n\nreturn {\n  json: {\n    drug: drug.drug_keyword,\n    priority: drug.priority,\n    department: drug.department,\n    affected_presentations: drug.affected_presentations,\n    unavailable_count: drug.unavailable_count,\n    limited_count: drug.limited_count,\n    ...triage,\n    recently_alerted: recentlyAlerted,\n    escalate: meetsRule && !recentlyAlerted,\n  },\n};"
      },
